# Telegram
TELEGRAM_BOT_TOKEN=coloque_o_token_do_botfather_aqui
TELEGRAM_CHANNEL_ID=@seucanal

# Shopee Affiliate Open API
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Amazon PA API
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_COUNTRY=BR

# Regras de filtro
MIN_DISCOUNT_PERCENT=30
MIN_PRICE=0
MAX_PRICE=1000

# Execução
CHECK_INTERVAL_HOURS=6
DATABASE_PATH=ofertas.db

# Painel administrativo — defina uma senha forte antes de publicar
ADMIN_PASSWORD=

# WhatsApp (grupos, via whatsapp-service/Baileys)
# WHATSAPP_SERVICE_URL só precisa mudar se você renomear o serviço no
# docker-compose.yml (o padrão já bate com o nome "whatsapp").
WHATSAPP_SERVICE_URL=http://whatsapp:3000
WHATSAPP_SERVICE_TOKEN=defina_um_segredo_forte_aqui
